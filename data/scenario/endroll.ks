*start
[fadeoutbgm time="1000" ]
[wait time="3000" ]
[layopt layer="message" visible="false" ]
[bg storage="endroll/endroll1.png" time="0"]
[playbgm storage=".mp3"]
[mask_off time="2000" ]
[wait_plus skip="false" time="4000" ]
[bg storage="endroll/endroll2.png" time="2000"]
[wait_plus skip="false" time="4000" ]
[bg storage="endroll/endroll3.png" time="2000"]
[wait_plus skip="false" time="4000" ]
[bg storage="endroll/endroll4.png" time="2000"]
[wait_plus skip="false" time="4000" ]
[bg storage="endroll/endroll5.png" time="2000"]
[wait_plus skip="false" time="4000" ]
[bg storage="endroll/endroll6.png" time="2000"]
[wait_plus skip="false" time="4000" ]
[bg storage="endroll/endroll7.png" time="2000"]
[wait_plus skip="false" time="4000" ]

[mask time="1000" ]
[bg storage="黒.png" ]
[fadeoutbgm time="1000" ]
[layopt layer="message" visible="true" ]
[return]